#!/bin/bash

set -e

GIT_VER=$1
case $2 in
  /*) PARMS_FILE=$2 ;;
  *) PARMS_FILE=$(pwd)/$2 ;;
esac

SCOWL=$(cd "${SCOWL:-.}" && pwd)

rm -rf aspell6-en-custom
cp -pPR "$SCOWL/speller/aspell-custom" aspell6-en-custom
cd aspell6-en-custom
. README.in.sh > README
rm README.in.sh
mkdir lang
cp -p "$SCOWL"/speller/aspell/{en.dat,en_affix.dat,en_phonet.dat} lang/
mkdir doc
cp -p "$SCOWL/README" doc/SCOWL-README

cat > en-custom.wl

./configure

make dist

mv aspell6-en-custom.tar.bz2 ..
cd ..
rm -r aspell6-en-custom


