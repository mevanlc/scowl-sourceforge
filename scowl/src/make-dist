#!/bin/sh

# Make the final release from a clean git checkout to avoid including
# unnecessary garbage!

set -e

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 VERSION"
  exit 1
fi

case $1 in
  ''|*[!A-Za-z0-9._-]*)
    echo "Invalid version: $1" >&2
    exit 1
    ;;
esac

dist="scowl-$1"
# Prevent macOS tar from adding AppleDouble metadata files to releases.
export COPYFILE_DISABLE=1

echo clean

make -s clean

rm -rf "$dist"
rm -f "$dist.tar" "$dist.tar.gz" "$dist.zip"

echo levels

rm -f l/levels-list
LC_ALL=C ls -lR l > l.dir
tar -c -f l.tar l/

echo copy

mkdir "$dist"
 
mkdir "$dist/r"
cp -p r/README "$dist/r/"
cp -pPR r/special "$dist/r/"

for source in r/*
do
  case $source in
    r/README|r/special|r/ATTIC) continue ;;
  esac
  [ -d "$source" ] || continue
  echo "... $source"
  mkdir "$dist/$source"
  while IFS= read -r file || [ -n "$file" ]; do
    [ -n "$file" ] || continue
    cp -p "$source/$file" "$dist/$source/"
  done < "$source/.keep"
done

cp -pPR README README.in Makefile mk-list Copyright l.dir l.tar src final misc speller "$dist/"
printf '%s\n' "$1" > "$dist/VERSION"

echo tar
tar -cf "$dist.tar" "$dist/"
gzip -9 "$dist.tar"

echo zip
cd "$dist"
rm speller/final speller/misc speller/src
zip -q9lr "../$dist.zip" -- *

